{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "project": ["src/**/*.ts", "src/**/*.tsx"],
  "entry": ["src/app/**/*.ts", "src/app/**/*.tsx"],
  "ignore": [
    "./public",
    "./node_modules",
    "./modules",
    "./ios",
    "./android",
    "./coverage",
    "./.pnpm-store",
    "babel.config.js",
    "metro.config.js"
  ],
  "ignoreDependencies": [
    "@react-navigation/native-stack",
    "@react-navigation/native",
    "@react-navigation/elements",
    "expo-application",
    "expo-device",
    "react-native-nitro-modules",
    "@tamagui/core",
    "@tamagui/get-button-sized",
    "@tamagui/get-token",
    "@tamagui/focusable",
    "@tamagui/shorthands",
    "@tamagui/themes",
    "expo-linear-gradient"
  ],
  "ignoreBinaries": ["supabase"]
}
